# Copy this file to .env.local and fill in the values.
# (gitignored — never commit real secrets)

# REQUIRED — random string used to sign login sessions. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin account created on first boot (also settable on Railway/Render).
ADMIN_EMAIL=admin@lakshya.in
# ⚠️ CHANGE THIS before going live — it's the password to your admin panel.
ADMIN_PASSWORD=admin123

# Real emails (Resend). Without a key, emails print to the server log (dev mode).
# Get a key at https://resend.com — it's free for ~3,000 emails/month.
RESEND_API_KEY=
EMAIL_FROM=Lakshya Referrals <onboarding@resend.dev>

# Public base URL — used in generated referral links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite file lives. Set to /data on Railway/Render volumes.
DATA_DIR=./.data

# Extra admin emails to notify on withdrawals (comma-separated). Defaults to
# all admin/superadmin users in the database.
ADMIN_EMAILS=
